
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


//! user model
model User {
  id String @id @default(uuid())
  email String @unique
  password String
  role String @default("USER")
  createdAt DateTime @default(now())
}

//! blacklisted model
model Blacklisted {
  id String @id @default(uuid())
  token String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime 
}

//! campaign
model Campaigns {
  id String @id @default(uuid())
  title Json
  description Json
  summary Json
  keyPoints Json
  imageUrl Json
  goalAmount Float
  raisedAmount Float @default(0)
  location Json
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])

  status Status

  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

 

  comments comment[]
  donation Donation[]

  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId])
}

//! enum status
enum Status {
  Active
  Completed
  Inactive
}

//! category 
model Category {
  id String @id @default(uuid())
  name Json @unique

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt 

  campaigns Campaigns[]
  blogs Blog[]
}

//! comment
model comment {
  id String @id @default(uuid())
  name String
  email String
  comment String @db.Text
  campaignId String?
  blogId String?
  eventId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentCommentId String?

  likeCount Int @default(0)
  
  status commentStatus @default(PENDING)


  campaign Campaigns? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  blog Blog? @relation(fields: [blogId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

//! self relation
  replies comment[] @relation("commentReplies")
  parent comment? @relation("commentReplies", fields: [parentCommentId], references: [id])

  @@index([campaignId, status])
  @@index([blogId, status])
  @@index([eventId, status])
  @@index([createdAt(sort: Desc)])
}

//! comment status
enum commentStatus  {
  PENDING
  APPROVED
  REJECTED
}



//! blog
model Blog {
  id String @id @default(uuid())
  creator Json
  title Json
  description Json
  summary Json
  quote Json
  quoteAuthor Json
  tags Json
  keyPoints Json
  location Json
  imageUrl Json

  categoryId String
  category Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments comment[]

  @@index([categoryId, createdAt(sort: Desc)])
}

//! Member
model Member {
  id String @id @default(uuid())
  name Json
  position Json
  description Json
  about Json
  title Json?
  keyPoints Json
  imageUrl Json
  facebookUrl String?
  twitterUrl String?
  instagramUrl String?
  linkedInUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


//! Banner
model Banner {
  id String @id @default(uuid())
  pageName String @default("Home")
  title Json
  subtitle Json
  description Json?
  priority Int
  imageUrl Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageName, priority])
}


//! form
model Form {
  id String @id @default(uuid())
  formType String
  firstName String?
  lastName String?
  email String
  phone String
  address String?
  occupation String?
  message String @db.Text
  isViewed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([formType, createdAt(sort: Desc)])
}

//! feedback
model Feedback {
  id String @id @default(uuid())
  name String
  designation String
  imageUrl Json?
  feedback String @db.Text
  rating Int
  status commentStatus @default(PENDING)

  createdAt DateTime @default(now())
}

model Donation {
  id String @id @default(uuid())
  razorpayId String? @unique
  orderId String? @unique
  amount Float
  status String @default("created")
  paymentMethod String @default("online")
  receiptNumber String? @unique
  
  firstName String?
  lastName String?
  email String?
  phone String?
  address String?
  pan String?
  message String? @db.Text

  campaignId String?
  campaign Campaigns? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([campaignId, status])
  @@index([paymentMethod])
  @@index([orderId])
  @@index([receiptNumber])
  @@index([createdAt])
}

model EmailSubscriber {
  id String @id @default(uuid())
  email String @unique
  createdAt DateTime @default(now())
}

model Event {
  id String @id @default(uuid())
  title Json
  description Json
  summary Json
  keyPoints Json
  location Json
  latitude Float
  longitude Float
  imageUrl Json
  startTime DateTime
  endTime DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments comment[]

  @@index([startTime, endTime])
  @@index([createdAt(sort: Desc)])
}

model Sponsor {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             Json
  category         Json
  location         Json?
  shortDescription Json
  description      Json
  website          String?
  imageUrl         Json

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

//! Gallery Image
model GalleryImage {
  id        String   @id @default(uuid())
  imageUrl  Json     // { url: String, public_id: String }
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//! Notification Model for Admin System Notifications
model Notification {
  id        String   @id @default(uuid())
  type      String   // "donation", "inquiry", "campaign", "offline_verification"
  title     String
  message   String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

//! Internship Status Enum
enum InternshipStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEWED
  SELECTED
  REJECTED
}

//! Internship Mode Enum
enum InternshipMode {
  REMOTE
  HYBRID
  ON_SITE
}

//! Internship Application Model
model InternshipApplication {
  id                  String            @id @default(uuid())
  applicationNumber   String            @unique // e.g. YUWA-INT-2026-XXXX
  fullName            String
  email               String
  phone               String            // Indian standard 10-digit number
  whatsappNumber      String?
  gender              String?           // Male, Female, Other
  
  // Applicant Classification & Personal Info (from PDF)
  applicantType       String            @default("STUDENT") // "STUDENT" | "WORKING_PROFESSIONAL"
  dob                 String?           // Date of Birth
  stateOfOrigin       String?           // State of Origin
  photoUrl            String?           // Cloudinary photo URL
  photoPublicId       String?           // Cloudinary photo public_id
  
  // Addresses (from PDF)
  currentAddress      String?           @db.Text
  permanentAddress    String?           @db.Text
  address             String?           @db.Text // Legacy address
  city                String?
  state               String?
  pincode             String?           // 6-digit PIN
  
  // Academic Background
  highestQualification String?          // User text input (e.g. B.Tech CSE, MBA, B.A. etc.)
  college             String?           // University, College, or Institute Name
  course              String?           // Degree / course currently being pursued (if any)
  specialization      String?           // Specialization / Branch / Stream
  branch              String?           // Alias for backward compatibility
  yearOfStudy         String?           @default("Ongoing")
  passingYear         Int?              // Passing / Expected year
  scoreType           String?           @default("PERCENTAGE")
  score               Float?
  tenthPercentage     Float?
  twelfthPercentage   Float?
  currentCgpa         Float?
  
  // Skills & Languages (from PDF)
  areaOfInterest      String?           // Area of interest
  specificSkills      String?           // Specific skills
  languages           Json?             // Array of languages spoken/written e.g. ["English", "Hindi"]
  
  // Prior Internship Experience (for Students)
  hasInternshipExp    Boolean?          @default(false)
  internshipOrgName   String?           // Organization Name
  internshipLocation  String?           // Location
  internshipDuration  String?           // Duration of internship
  internshipProjectNature String?       // Nature of internship project
  
  // Professional Experience (for Working Professionals)
  currentDesignation  String?           // Current profession / designation
  currentOrganization String?           // Current company / organization
  workExperienceYears String?           // Total work experience (e.g. "2 Years")
  
  // Internship Preferences & Logistics (from PDF)
  domain              String            // Health, Women Empowerment, Education, Tech, etc.
  domainReason        String?           @db.Text // Reason why candidate is suited for this domain
  weeksAvailable      String?           // No. of weeks you can give in (e.g. "8 Weeks")
  startMonthWeek      String?           // Month and week you can begin (if selected)
  familiarWithComputer Boolean?         @default(true) // Whether familiar with Computer/Internet?
  whyJoin             String?           @db.Text // 150-word write-up on motivation & contribution
  duration            String?           @default("3 Months") // Legacy duration
  mode                InternshipMode    @default(HYBRID) // Legacy mode
  
  // Resume & Portfolio Links
  resumeUrl           String            // Secure Cloudinary URL
  resumePublicId      String?
  resumeOriginalName  String?
  resumeMimeType      String?
  resumeSize          Int?              // in bytes
  linkedinUrl         String?
  githubUrl           String?
  portfolioUrl        String?
  
  // Admin Workflow
  status              InternshipStatus  @default(PENDING)
  adminRemarks        String?           @db.Text
  isViewed            Boolean           @default(false)
  isArchived          Boolean           @default(false)
  ipAddress           String?
  
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([applicantType, status])
  @@index([domain, status])
  @@index([email])
  @@index([phone])
  @@index([applicationNumber])
  @@index([createdAt(sort: Desc)])
}

//! Trainee Alumni Model (Scrolling showcase on Main page & Career page)
model TraineeAlumni {
  id              String    @id @default(uuid())
  name            Json      // { en: "Rahul Sharma", hi: "राहुल शर्मा" }
  imageUrl        Json      // { url: String, public_id: String }
  university      Json      // { en: "Gorakhpur University (DDU)", hi: "..." }
  domain          Json      // { en: "Web Development", hi: "वेब डेवलपमेंट" }
  batch           String    // e.g. "Batch 2025", "Summer 2024"
  duration        String?   @default("3 Months") // e.g. "3 Months", "6 Months"
  testimonial     Json?     // Optional feedback quote
  linkedinUrl     String?
  displayOrder    Int       @default(0)
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive, displayOrder])
  @@index([createdAt(sort: Desc)])
}